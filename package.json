{
  "name": "cchat",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first mobile companion for Codex sessions",
  "type": "module",
  "bin": {
    "cchat-cli": "bin/cchat-cli"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "check:browser": "node --check public/app.js",
    "build:relay-client": "esbuild src/browser/pair.ts src/browser/relay-home.ts --bundle --format=esm --platform=browser --target=safari17 --outdir=relay-public",
    "check:scripts": "node --check scripts/install-user-service.mjs && node --check scripts/uninstall-user-service.mjs && node --check scripts/init-relay.mjs && node --check scripts/claim-bridge.mjs && node --check scripts/create-pairing.mjs && node --check scripts/devices.mjs && node -e \"import('./src/bridge/remote.ts')\"",
    "test": "node --test src/**/*.test.ts",
    "check": "npm run typecheck && npm run build:relay-client && npm run check:browser && npm run check:scripts && npm test",
    "service:install": "node scripts/install-user-service.mjs",
    "service:uninstall": "node scripts/uninstall-user-service.mjs",
    "service:status": "systemctl --user status cchat.service",
    "bridge:claim": "node scripts/claim-bridge.mjs",
    "pair": "node scripts/create-pairing.mjs",
    "devices": "node scripts/devices.mjs",
    "relay:init": "node scripts/init-relay.mjs",
    "relay:start": "node src/relay/server.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "libsodium-wrappers-sumo": "^0.8.4",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0"
  }
}
